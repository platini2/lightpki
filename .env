PKI_HOME=/opt/pki
DOMAIN=example.com
OCSP=true
OCSP_PORT=2560
OCSP_SERVER=false
CRL=false
ADMIN_UI=false
ADMIN_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TESTING123
EXPIRY_WARNING_DAYS=30
EXPIRY_WEBHOOK_URL=
EXPIRY_CHECK_INTERVAL_HOURS=24
CRL_REGEN_INTERVAL_HOURS=24
ROOTCA_DIRECTORY=/opt/pki/root
ROOTCA_PASSPHRASE=TESTING123
ROOTCA_KEY_SPEC=4096
INTERMEDIATECA_DIRECTORY=/opt/pki/intermediate
INTERMEDIATECA_PASSPHRASE=TESTING123
INTERMEDIATECA_KEY_SPEC=4096
OUTPUT_DIRECTORY=/opt/pki/out
C=US
ST="New York"
L="New York"
O="Example"
OU="Example Certificate Authority"
ROOTCN="Example Root CA"
INTERMEDIATECN="Example Intermediate CA"
MAIL="admin@example.com"
