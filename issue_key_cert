#!/bin/sh
set -e
umask 077
if [ $# -lt 4 ] ; then
    echo 'issue_key_cert <CN> <OU> <extension> <key_spec> [SAN_LIST]'
    echo '<extension> - server_cert / usr_cert / ocsp'
    echo '<key_spec>  - RSA key length (2048, 4096) or EC curve name (prime256v1, secp384r1, secp521r1)'
    echo '<SAN_LIST>  - optional comma-separated extra SAN entries as DNS:name or IP:address'
    echo '              (CN is always included as a SAN automatically)'
    echo 'issue_key_cert ftp.example.com "FTP Server" server_cert 2048'
    echo 'issue_key_cert ftp.example.com "FTP Server" server_cert prime256v1'
    echo 'issue_key_cert www.example.com "Web Service" server_cert 2048 "DNS:example.com,IP:10.0.0.5"'
    exit 1
fi
CN=$1
OU=$2
case "$CN" in
    \*.*)
        WILDCARD_REST=${CN#\*.}
        case "$WILDCARD_REST" in
            ''|*[!A-Za-z0-9._-]*)
                echo "Invalid CN '$CN': wildcard must be '*.' followed by letters, digits, '.', '_', '-'" >&2
                exit 1
                ;;
        esac
        ;;
    *[!A-Za-z0-9._-]*)
        echo "Invalid CN '$CN': only letters, digits, '.', '_', '-', or a single leading '*.' wildcard are allowed" >&2
        exit 1
        ;;
esac
DN="/C=$C/ST=$ST/L=$L/O=$O/OU=$OU/CN=$CN/emailAddress=$MAIL"
echo "-----------------------------"
echo "Issuing Intermediate CA Certificate for $1"
echo "-----------------------------"
cd $INTERMEDIATECA_DIRECTORY
case "$4" in
    ''|*[!0-9]*)
        if ! openssl ecparam -name "$4" -noout >/dev/null 2>&1; then
            echo "Invalid key spec '$4': must be an RSA key length (e.g. 2048, 4096) or a known EC curve name (e.g. prime256v1, secp384r1, secp521r1)" >&2
            exit 1
        fi
        openssl ecparam -name "$4" -genkey -noout -out "private/$1.key.pem"
        ;;
    *)
        openssl genrsa -out "private/$1.key.pem" $4
        ;;
esac
chmod 400 "private/$1.key.pem"
echo "Created Key for $1"
SAN="DNS:$CN"
if [ $# -ge 5 ] ; then
    SAN_LIST=$5
    case "$SAN_LIST" in
        *[!A-Za-z0-9:.,_*-]*)
            echo "Invalid SAN list '$SAN_LIST': use comma-separated DNS:name or IP:address entries" >&2
            exit 1
            ;;
    esac
    OLDIFS=$IFS
    IFS=,
    for entry in $SAN_LIST; do
        case "$entry" in
            DNS:?*|IP:?*)
                ;;
            *)
                IFS=$OLDIFS
                echo "Invalid SAN entry '$entry': each entry must start with DNS: or IP:" >&2
                exit 1
                ;;
        esac
        SAN="$SAN,$entry"
    done
    IFS=$OLDIFS
fi
openssl req -config ../intermediate-openssl.cnf \
  -key "private/$1.key.pem" \
  -new -sha256\
  -out "csr/$1.csr.pem" \
  -subj "$DN" \
  -addext "subjectAltName = $SAN"
echo "Created Certificate Request for $1"
openssl ca -batch -config ../intermediate-openssl.cnf \
      -extensions $3 -days ${CERT_DAYS:-3650} -notext -md sha256 \
      -passin env:INTERMEDIATECA_PASSPHRASE \
      -in "csr/$1.csr.pem" \
      -out "certs/$1.cert.pem"
chmod 444 "certs/$1.cert.pem"
echo "Created Certificate for $1"
echo "Verifying Certificate for $1"
openssl x509 -noout -text \
	      -in "certs/$1.cert.pem"
openssl verify -CAfile certs/ca-chain.cert.pem \
	      "certs/$1.cert.pem"
echo "Packing Certificates for $1"
zip "$OUTPUT_DIRECTORY/$1.zip" "certs/$1.cert.pem" "private/$1.key.pem" certs/ca-chain.cert.pem
