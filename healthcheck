#!/bin/sh
# Container health check, used by the Dockerfile's HEALTHCHECK: healthy when
# every enabled service actually answers.
set -e
if [ "$ADMIN_UI" = "true" ]; then
    python3 -c 'import socket, sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 3).close()' "${ADMIN_PORT:-8080}"
fi
if [ "$OCSP_SERVER" = "true" ]; then
    # Send a real OCSP request (for the responder's own certificate) rather
    # than just opening the port: the responder handles one connection at a
    # time, so a bare connect would make it wait for a request that never
    # comes, and only answering proves it works.
    cd "$INTERMEDIATECA_DIRECTORY"
    timeout 10 openssl ocsp -url "http://127.0.0.1:${OCSP_PORT:-2560}" -timeout 5 \
        -CAfile certs/ca-chain.cert.pem \
        -issuer certs/intermediate.cert.pem \
        -cert "certs/ocsp.$DOMAIN.cert.pem" 2>/dev/null \
        | grep -qE ': (good|revoked|unknown)$'
fi
