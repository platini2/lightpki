#!/bin/sh
# Container health check: healthy when every enabled service accepts TCP
# connections on its port. Used by the Dockerfile's HEALTHCHECK.
set -e
port_open() {
    python3 -c 'import socket, sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 3).close()' "$1"
}
if [ "$ADMIN_UI" = "true" ]; then
    port_open "${ADMIN_PORT:-8080}"
fi
if [ "$OCSP_SERVER" = "true" ]; then
    port_open "${OCSP_PORT:-2560}"
fi
