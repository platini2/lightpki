#!/bin/sh
# Container health check, used by the Dockerfile's HEALTHCHECK: healthy when
# every enabled service actually answers. Pass service names (admin, ocsp,
# crl, acme) to check only those, e.g. `./healthcheck ocsp`.
set -e
SERVICES=$*
if [ -z "$SERVICES" ]; then
    [ "$ADMIN_UI" = "true" ] && SERVICES="$SERVICES admin"
    [ "$OCSP_SERVER" = "true" ] && SERVICES="$SERVICES ocsp"
    [ "$CRL" = "true" ] && SERVICES="$SERVICES crl"
    [ "$ACME" = "true" ] && SERVICES="$SERVICES acme"
fi

# GET a URL on localhost; any HTTP status counts as "answering" (the admin UI
# replies 401 without credentials). TLS isn't verified: it's our own port.
http_answers() {
    python3 - "$1" <<'EOF'
import ssl, sys, urllib.error, urllib.request
ctx = ssl._create_unverified_context()
try:
    urllib.request.urlopen(sys.argv[1], timeout=5, context=ctx).read(1)
except urllib.error.HTTPError:
    pass
EOF
}

for service in $SERVICES; do
    case "$service" in
        admin)
            if [ "$ADMIN_TLS" = "true" ]; then scheme=https; else scheme=http; fi
            http_answers "$scheme://127.0.0.1:${ADMIN_PORT:-8080}/"
            ;;
        ocsp)
            # A real OCSP request (for the responder's own certificate), not
            # just a TCP connect: the responder handles one connection at a
            # time, so a bare connect would make it wait for a request that
            # never comes, and only answering proves it works.
            (
                cd "$INTERMEDIATECA_DIRECTORY"
                timeout 10 openssl ocsp -url "http://127.0.0.1:${OCSP_PORT:-2560}" -timeout 5 \
                    -CAfile certs/ca-chain.cert.pem \
                    -issuer certs/intermediate.cert.pem \
                    -cert "certs/ocsp.$DOMAIN.cert.pem" 2>/dev/null \
                    | grep -qE ': (good|revoked|unknown)$'
            )
            ;;
        crl)
            http_answers "http://127.0.0.1:${CRL_PORT:-8081}/intermediate.crl"
            ;;
        acme)
            http_answers "https://127.0.0.1:${ACME_PORT:-8443}/acme/directory"
            ;;
        *)
            echo "unknown service '$service'" >&2
            exit 2
            ;;
    esac
done
