#!/bin/sh
set -e
. "$(dirname "$0")/pki_env"
INIT_FLAG="$ROOTCA_DIRECTORY/.initialized"
OCSP_NAME="ocsp.$DOMAIN"

# The container runs as an unprivileged user (see Dockerfile). Host-mounted
# volumes created by older root-run versions are owned by root, which would
# make every script fail with a confusing "Permission denied" halfway through.
for d in "$ROOTCA_DIRECTORY" "$INTERMEDIATECA_DIRECTORY" "$OUTPUT_DIRECTORY"; do
    if [ ! -w "$d" ]; then
        echo "$d is not writable by uid $(id -u). If it is a host volume from an older" >&2
        echo "version, run on the host: sudo chown -R $(id -u):$(id -g) <host dir>" >&2
        exit 1
    fi
done

# intermediate-openssl.cnf ships inside the image, not a persisted volume,
# so it resets to the checked-in placeholder defaults on every rebuild.
# Keep it retemplated on every start (not just first-init) so the OCSP/CRL
# URIs baked into newly issued certs don't silently revert to
# ocsp.example.com/example.com after a rebuild.
if [ "$OCSP" = "true" ]; then
    sed -i "s|.*authorityInfoAccess.*|authorityInfoAccess = OCSP;URI:http://$OCSP_NAME:$OCSP_PORT|" intermediate-openssl.cnf
else
    sed -i "s|.*authorityInfoAccess.*|#authorityInfoAccess = OCSP;URI:http://ocsp.example.com|" intermediate-openssl.cnf
fi
if [ "$CRL" = "true" ]; then
    # Served by admin/crl_server.py (DER, as RFC 5280 expects for HTTP).
    CRL_PORT=${CRL_PORT:-8081}
    if [ "$CRL_PORT" = "80" ]; then CRL_HOSTPORT="crl.$DOMAIN"; else CRL_HOSTPORT="crl.$DOMAIN:$CRL_PORT"; fi
    sed -i "s|.*crlDistributionPoints.*|crlDistributionPoints = URI:http://$CRL_HOSTPORT/intermediate.crl|" intermediate-openssl.cnf
else
    sed -i "s|.*crlDistributionPoints.*|#crlDistributionPoints = URI:http://example.com/intermediate.crl.pem|" intermediate-openssl.cnf
fi

if [ ! -f "$INIT_FLAG" ]; then
    ./create_root_ca
    ./create_intermediate_ca
    ./sign_root_ca "$INTERMEDIATECA_DIRECTORY/csr/intermediate.csr.pem" "$INTERMEDIATECA_DIRECTORY/certs/intermediate.cert.pem" "$INTERMEDIATECA_DIRECTORY/certs/ca-chain.cert.pem"
    ./generate_crl
    if [ "$OCSP" = "true" ]; then
        ./issue_key_cert "$OCSP_NAME" "OCSP Service" ocsp 4096
    fi
    ./issue_key_cert "www.$DOMAIN" "Web Service" server_cert 2048
    touch "$INIT_FLAG"
fi

# Allow several valid certificates per name (ACME renewals). The database
# attribute file, once written, overrides the config, so update it too.
if [ -f "$INTERMEDIATECA_DIRECTORY/index.txt.attr" ]; then
    sed -i 's/^unique_subject = yes$/unique_subject = no/' "$INTERMEDIATECA_DIRECTORY/index.txt.attr"
fi

# Refresh the CRL (PEM and DER) on every start, so the CRL server has a
# current DER copy even on installs created before it existed.
./generate_crl >/dev/null || echo "CRL regeneration failed" >&2

# The ACME server needs a TLS certificate for its own name. Issued once, on
# the first start with ACME=true.
ACME_NAME="acme.$DOMAIN"
if [ "$ACME" = "true" ] && [ ! -f "$INTERMEDIATECA_DIRECTORY/certs/$ACME_NAME.cert.pem" ]; then
    ./issue_key_cert "$ACME_NAME" "ACME Service" server_cert 2048 >/dev/null
fi

# The root CA is only needed to sign the intermediate, which happened above.
# Nothing started below (admin UI, OCSP responder, CRL refresh) uses it, so
# don't hand its passphrase to any long-running process.
unset ROOTCA_PASSPHRASE
if [ -f "$ROOTCA_DIRECTORY/private/ca.key.pem" ]; then
    echo "WARNING: the root CA private key is still on this server" >&2
    echo "         ($ROOTCA_DIRECTORY/private/ca.key.pem). Move it to offline storage" >&2
    echo "         and drop ROOTCA_PASSPHRASE from the container's environment;" >&2
    echo "         see 'Taking the root CA offline' in the README." >&2
fi

# Restart a service if it ever dies, instead of silently losing it while the
# rest of the container keeps running.
run_forever() {
    name=$1
    shift
    while true; do
        "$@" || true
        echo "$name exited; restarting in 5s" >&2
        sleep 5
    done
}

# OpenSSL's responder handles one connection at a time and waits forever for
# a request, so a single client that connects without sending one (port
# scanner, load-balancer TCP probe) freezes it; its -timeout option doesn't
# help on OpenSSL 3.1. Send it a real query every 30s and kill it if it
# doesn't answer, so run_forever starts a fresh one.
ocsp_watchdog() {
    while true; do
        sleep 30
        if ! ./healthcheck ocsp; then
            echo "OCSP responder not answering; restarting it" >&2
            pkill -f "openssl ocsp -port" || true
        fi
    done
}

# The admin UI regenerates the CRL on its own schedule. Without it, do the
# same here so the CRL (valid for default_crl_days = 30) never goes stale.
crl_regen_forever() {
    interval=$(awk -v h="${CRL_REGEN_INTERVAL_HOURS:-24}" 'BEGIN { print int(h * 3600) }')
    while true; do
        sleep "$interval"
        ./generate_crl >/dev/null || echo "Periodic CRL regeneration failed" >&2
    done
}

# Background services. In admin UI mode they become children of the admin
# UI process; otherwise this shell waits on them.
BACKGROUND=false
if [ "$OCSP_SERVER" = "true" ]; then
    run_forever "OCSP server" ./start_ocsp_server "$OCSP_NAME" &
    ocsp_watchdog &
    BACKGROUND=true
fi
if [ "$CRL" = "true" ]; then
    run_forever "CRL server" python3 admin/crl_server.py &
    BACKGROUND=true
fi
if [ "$ACME" = "true" ]; then
    # One worker process (nonces and the state lock live in it), several
    # threads. TLS with the certificate issued for acme.$DOMAIN above.
    run_forever "ACME server" python3 -m gunicorn --chdir admin \
        --bind "0.0.0.0:${ACME_PORT:-8443}" --workers 1 --threads 8 --timeout 120 \
        --certfile "$INTERMEDIATECA_DIRECTORY/certs/$ACME_NAME.cert.pem" \
        --keyfile "$INTERMEDIATECA_DIRECTORY/private/$ACME_NAME.key.pem" \
        --access-logfile - acme:app &
    BACKGROUND=true
fi

if [ "$ADMIN_UI" = "true" ]; then
    echo "Starting admin UI on port ${ADMIN_PORT:-8080}"
    exec python3 admin/app.py
elif [ "$BACKGROUND" = "true" ]; then
    # This shell is PID 1 here, so stop the children on `docker stop`.
    trap 'trap - TERM INT; kill 0; exit 0' TERM INT
    crl_regen_forever &
    wait
else
    echo "PKI ready (no services enabled; nothing will refresh the CRL)"
fi
