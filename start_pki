#!/bin/sh
set -e
. "$(dirname "$0")/pki_env"
INIT_FLAG="$ROOTCA_DIRECTORY/.initialized"
OCSP_NAME="ocsp.$DOMAIN"

# The container runs as an unprivileged user (see Dockerfile). Host-mounted
# volumes created by older root-run versions are owned by root, which would
# make every script fail with a confusing "Permission denied" halfway through.
for d in "$ROOTCA_DIRECTORY" "$INTERMEDIATECA_DIRECTORY" "$OUTPUT_DIRECTORY"; do
    if [ ! -w "$d" ]; then
        echo "$d is not writable by uid $(id -u). If it is a host volume from an older" >&2
        echo "version, run on the host: sudo chown -R $(id -u):$(id -g) <host dir>" >&2
        exit 1
    fi
done

# intermediate-openssl.cnf ships inside the image, not a persisted volume,
# so it resets to the checked-in placeholder defaults on every rebuild.
# Keep it retemplated on every start (not just first-init) so the OCSP/CRL
# URIs baked into newly issued certs don't silently revert to
# ocsp.example.com/example.com after a rebuild.
if [ "$OCSP" = "true" ]; then
    sed -i "s|.*authorityInfoAccess.*|authorityInfoAccess = OCSP;URI:http://$OCSP_NAME:$OCSP_PORT|" intermediate-openssl.cnf
else
    sed -i "s|.*authorityInfoAccess.*|#authorityInfoAccess = OCSP;URI:http://ocsp.example.com|" intermediate-openssl.cnf
fi
if [ "$CRL" = "true" ]; then
    # Served by admin/crl_server.py (DER, as RFC 5280 expects for HTTP).
    CRL_PORT=${CRL_PORT:-8081}
    if [ "$CRL_PORT" = "80" ]; then CRL_HOSTPORT="crl.$DOMAIN"; else CRL_HOSTPORT="crl.$DOMAIN:$CRL_PORT"; fi
    sed -i "s|.*crlDistributionPoints.*|crlDistributionPoints = URI:http://$CRL_HOSTPORT/intermediate.crl|" intermediate-openssl.cnf
else
    sed -i "s|.*crlDistributionPoints.*|#crlDistributionPoints = URI:http://example.com/intermediate.crl.pem|" intermediate-openssl.cnf
fi

if [ ! -f "$INIT_FLAG" ]; then
    ./create_root_ca
    ./create_intermediate_ca
    ./sign_root_ca "$INTERMEDIATECA_DIRECTORY/csr/intermediate.csr.pem" "$INTERMEDIATECA_DIRECTORY/certs/intermediate.cert.pem" "$INTERMEDIATECA_DIRECTORY/certs/ca-chain.cert.pem"
    ./generate_crl
    if [ "$OCSP" = "true" ]; then
        ./issue_key_cert "$OCSP_NAME" "OCSP Service" ocsp 4096
    fi
    ./issue_key_cert "www.$DOMAIN" "Web Service" server_cert 2048
    touch "$INIT_FLAG"
fi

# Allow several valid certificates per name (ACME renewals). The database
# attribute file, once written, overrides the config, so update it too.
if [ -f "$INTERMEDIATECA_DIRECTORY/index.txt.attr" ]; then
    sed -i 's/^unique_subject = yes$/unique_subject = no/' "$INTERMEDIATECA_DIRECTORY/index.txt.attr"
fi

# Refresh the CRL (PEM and DER) on every start, so the CRL server has a
# current DER copy even on installs created before it existed.
./generate_crl >/dev/null || echo "CRL regeneration failed" >&2

# TLS certificates for LightPKI's own HTTPS services (ACME server, admin UI).
# 397 days: Apple platforms (Safari, Chrome on macOS) reject TLS server
# certificates valid for more than 825 days, even from a private CA, and
# LightPKI's default CERT_DAYS is 10 years. Reissued when missing, when
# expiring within 30 days, or when still valid for more than 825 days (a
# 10-year certificate from LightPKI 1.4).
SERVICE_CERT_DAYS=397
ACME_NAME="acme.$DOMAIN"
ADMIN_NAME="admin.$DOMAIN"
ADMIN_PID_FILE=/tmp/lightpki-admin.pid
ACME_PID_FILE=/tmp/lightpki-acme.pid
rm -f "$ADMIN_PID_FILE" "$ACME_PID_FILE"   # stale after a container restart

# gunicorn re-reads its certificate on every new connection, and its worker
# dies if that fails, so it never reads files that something else replaces
# (issue_key_cert on renewal, certbot on a mounted volume). Each HTTPS
# service gets a private copy instead: certificate chain and key in one
# file, swapped in atomically and only once the pair matches. If the source
# can't be read for a while, the last good certificate keeps being served.
TLS_RUN_DIR=/tmp/lightpki-tls
mkdir -p "$TLS_RUN_DIR"
chmod 700 "$TLS_RUN_DIR"
ACME_BUNDLE="$TLS_RUN_DIR/acme.pem"
ADMIN_BUNDLE="$TLS_RUN_DIR/admin.pem"

# ensure_service_cert <name> <OU> [SAN_LIST]: issue or reissue as needed.
ensure_service_cert() {
    svc_cert="$INTERMEDIATECA_DIRECTORY/certs/$1.cert.pem"
    svc_key="$INTERMEDIATECA_DIRECTORY/private/$1.key.pem"
    if [ -f "$svc_cert" ] && [ -f "$svc_key" ] \
        && openssl x509 -checkend 2592000 -noout -in "$svc_cert" >/dev/null \
        && ! openssl x509 -checkend 71280000 -noout -in "$svc_cert" >/dev/null; then
        return 0
    fi
    [ -f "$svc_cert" ] && echo "Reissuing the $1 certificate ($SERVICE_CERT_DAYS days)" >&2
    rm -f "$svc_cert" "$svc_key"
    CERT_DAYS=$SERVICE_CERT_DAYS ./issue_key_cert "$1" "$2" server_cert 2048 ${3:+"$3"} >/dev/null
}

cert_fingerprint() {
    openssl x509 -noout -fingerprint -sha256 -in "$1" 2>/dev/null
}

# Same public key in both files? Never install a pair caught halfway through
# a renewal.
cert_matches_key() {
    cert_pub=$(openssl x509 -noout -pubkey -in "$1" 2>/dev/null) || return 1
    key_pub=$(openssl pkey -pubout -in "$2" 2>/dev/null) || return 1
    [ -n "$cert_pub" ] && [ "$cert_pub" = "$key_pub" ]
}

# install_tls_bundle <cert> <key> <bundle>: 0 if it installed a new
# certificate; 1 if unchanged or the source pair isn't usable right now.
install_tls_bundle() {
    src_fingerprint=$(cert_fingerprint "$1")
    [ -n "$src_fingerprint" ] || return 1
    [ "$src_fingerprint" != "$(cert_fingerprint "$3")" ] || return 1
    cert_matches_key "$1" "$2" || return 1
    bundle_tmp=$(mktemp "$TLS_RUN_DIR/.bundle.XXXXXX") || return 1
    # Re-check the copy itself: the source may change while being copied.
    if cat "$1" > "$bundle_tmp" && echo >> "$bundle_tmp" && cat "$2" >> "$bundle_tmp" \
        && cert_matches_key "$bundle_tmp" "$bundle_tmp"; then
        mv -f "$bundle_tmp" "$3"
        return 0
    fi
    rm -f "$bundle_tmp"
    return 1
}

# Running servers pick the new file up on their next connection anyway; the
# HUP (a graceful gunicorn reload) makes sure.
reload_gunicorn() {
    if [ -f "$1" ]; then
        echo "New TLS certificate for the $2; reloading it" >&2
        kill -HUP "$(cat "$1")" 2>/dev/null || true
    fi
}

check_external_file() {
    if [ ! -e "$2" ]; then
        echo "$1=$2 can't be found by the LightPKI user (uid $(id -u), gid $(id -g))." >&2
        echo "Either the volume isn't mounted or the path is wrong (it's the path inside" >&2
        echo "the container), or a folder on the way isn't accessible: certbot keeps its" >&2
        echo "live/ and archive/ folders root-only; see 'Using a certbot certificate' in" >&2
        echo "the README for the deploy hook that grants read access." >&2
        exit 1
    fi
    if [ ! -r "$2" ]; then
        echo "$1=$2 is not readable by the LightPKI user (uid $(id -u), gid $(id -g))." >&2
        echo "certbot keeps private keys readable by root only; see 'Using a certbot" >&2
        echo "certificate' in the README for the deploy hook that grants read access." >&2
        exit 1
    fi
}

# ADMIN_TLS=true serves the admin UI over HTTPS: with ADMIN_TLS_CERT and
# ADMIN_TLS_KEY if given (e.g. a certbot / Let's Encrypt certificate from a
# mounted volume), otherwise with a certificate LightPKI issues for
# admin.$DOMAIN plus ADMIN_TLS_SANS (default localhost and 127.0.0.1).
ADMIN_TLS_ISSUED=false
ADMIN_TLS_EXTERNAL=false
if [ "$ADMIN_UI" = "true" ] && [ "$ADMIN_TLS" = "true" ]; then
    if [ -n "$ADMIN_TLS_CERT" ] || [ -n "$ADMIN_TLS_KEY" ]; then
        if [ -z "$ADMIN_TLS_CERT" ] || [ -z "$ADMIN_TLS_KEY" ]; then
            echo "Set both ADMIN_TLS_CERT and ADMIN_TLS_KEY, or neither" >&2
            exit 1
        fi
        check_external_file ADMIN_TLS_CERT "$ADMIN_TLS_CERT"
        check_external_file ADMIN_TLS_KEY "$ADMIN_TLS_KEY"
        if ! cert_matches_key "$ADMIN_TLS_CERT" "$ADMIN_TLS_KEY"; then
            echo "ADMIN_TLS_CERT and ADMIN_TLS_KEY are not a valid matching PEM certificate and key" >&2
            exit 1
        fi
        if ! openssl x509 -checkend 0 -noout -in "$ADMIN_TLS_CERT" >/dev/null; then
            echo "WARNING: ADMIN_TLS_CERT has expired; is its renewal (certbot) running?" >&2
        fi
        ADMIN_TLS_EXTERNAL=true
        ADMIN_SRC_CERT=$ADMIN_TLS_CERT
        ADMIN_SRC_KEY=$ADMIN_TLS_KEY
    else
        ADMIN_TLS_ISSUED=true
        ADMIN_SRC_CERT="$INTERMEDIATECA_DIRECTORY/certs/$ADMIN_NAME.cert.pem"
        ADMIN_SRC_KEY="$INTERMEDIATECA_DIRECTORY/private/$ADMIN_NAME.key.pem"
    fi
fi

renew_service_certs() {
    if [ "$ACME" = "true" ]; then
        ensure_service_cert "$ACME_NAME" "ACME Service"
        install_tls_bundle "$INTERMEDIATECA_DIRECTORY/certs/$ACME_NAME.cert.pem" \
            "$INTERMEDIATECA_DIRECTORY/private/$ACME_NAME.key.pem" "$ACME_BUNDLE" \
            && reload_gunicorn "$ACME_PID_FILE" "ACME server"
    fi
    if [ "$ADMIN_TLS_ISSUED" = "true" ]; then
        ensure_service_cert "$ADMIN_NAME" "Admin UI" "${ADMIN_TLS_SANS-DNS:localhost,IP:127.0.0.1}"
    fi
    if [ "$ADMIN_TLS_ISSUED" = "true" ] || [ "$ADMIN_TLS_EXTERNAL" = "true" ]; then
        install_tls_bundle "$ADMIN_SRC_CERT" "$ADMIN_SRC_KEY" "$ADMIN_BUNDLE" \
            && reload_gunicorn "$ADMIN_PID_FILE" "admin UI"
    fi
    return 0
}
renew_service_certs
if [ "$ACME" = "true" ] && [ ! -s "$ACME_BUNDLE" ]; then
    echo "Could not set up the ACME server's TLS certificate" >&2
    exit 1
fi
if { [ "$ADMIN_TLS_ISSUED" = "true" ] || [ "$ADMIN_TLS_EXTERNAL" = "true" ]; } && [ ! -s "$ADMIN_BUNDLE" ]; then
    echo "Could not set up the admin UI's TLS certificate" >&2
    exit 1
fi

# Hourly by default: cheap (a few `openssl x509` reads), and a renewed
# certbot certificate is picked up within the hour.
service_cert_renewal_forever() {
    while true; do
        sleep "${SERVICE_CERT_CHECK_SECONDS:-3600}"
        renew_service_certs >/dev/null || echo "Service certificate renewal failed" >&2
    done
}

# The root CA is only needed to sign the intermediate, which happened above.
# Nothing started below (admin UI, OCSP responder, CRL refresh) uses it, so
# don't hand its passphrase to any long-running process.
unset ROOTCA_PASSPHRASE
if [ -f "$ROOTCA_DIRECTORY/private/ca.key.pem" ]; then
    echo "WARNING: the root CA private key is still on this server" >&2
    echo "         ($ROOTCA_DIRECTORY/private/ca.key.pem). Move it to offline storage" >&2
    echo "         and drop ROOTCA_PASSPHRASE from the container's environment;" >&2
    echo "         see 'Taking the root CA offline' in the README." >&2
fi

# Restart a service if it ever dies, instead of silently losing it while the
# rest of the container keeps running.
run_forever() {
    name=$1
    shift
    while true; do
        "$@" || true
        echo "$name exited; restarting in 5s" >&2
        sleep 5
    done
}

# OpenSSL's responder handles one connection at a time and waits forever for
# a request, so a single client that connects without sending one (port
# scanner, load-balancer TCP probe) freezes it; its -timeout option doesn't
# help on OpenSSL 3.1. Send it a real query every 30s and kill it if it
# doesn't answer, so run_forever starts a fresh one.
ocsp_watchdog() {
    while true; do
        sleep 30
        if ! ./healthcheck ocsp; then
            echo "OCSP responder not answering; restarting it" >&2
            pkill -f "openssl ocsp -port" || true
        fi
    done
}

# The admin UI regenerates the CRL on its own schedule. Without it, do the
# same here so the CRL (valid for default_crl_days = 30) never goes stale.
crl_regen_forever() {
    interval=$(awk -v h="${CRL_REGEN_INTERVAL_HOURS:-24}" 'BEGIN { print int(h * 3600) }')
    while true; do
        sleep "$interval"
        ./generate_crl >/dev/null || echo "Periodic CRL regeneration failed" >&2
    done
}

# Background services. In admin UI mode they become children of the admin
# UI process; otherwise this shell waits on them.
BACKGROUND=false
if [ "$OCSP_SERVER" = "true" ]; then
    run_forever "OCSP server" ./start_ocsp_server "$OCSP_NAME" &
    ocsp_watchdog &
    BACKGROUND=true
fi
if [ "$CRL" = "true" ]; then
    run_forever "CRL server" python3 admin/crl_server.py &
    BACKGROUND=true
fi
if [ "$ACME" = "true" ]; then
    # One worker process (nonces and the state lock live in it), several
    # threads. TLS with the certificate issued for acme.$DOMAIN above.
    run_forever "ACME server" python3 -m gunicorn --chdir admin \
        --bind "0.0.0.0:${ACME_PORT:-8443}" --workers 1 --threads 8 --timeout 120 \
        --certfile "$ACME_BUNDLE" \
        --pid "$ACME_PID_FILE" --access-logfile - acme:app &
    BACKGROUND=true
fi

if [ "$ACME" = "true" ] || [ "$ADMIN_TLS_ISSUED" = "true" ] || [ "$ADMIN_TLS_EXTERNAL" = "true" ]; then
    service_cert_renewal_forever &
fi

if [ "$ADMIN_UI" = "true" ] && [ "$ADMIN_TLS" = "true" ]; then
    echo "Starting admin UI on https port ${ADMIN_PORT:-8080}"
    # One worker: the CRL refresh and expiry alert threads run in it once.
    exec python3 -m gunicorn --chdir admin \
        --bind "0.0.0.0:${ADMIN_PORT:-8080}" --workers 1 --threads 8 --timeout 180 \
        --certfile "$ADMIN_BUNDLE" \
        --pid "$ADMIN_PID_FILE" --access-logfile - 'app:create_app()'
elif [ "$ADMIN_UI" = "true" ]; then
    echo "Starting admin UI on http port ${ADMIN_PORT:-8080}"
    exec python3 admin/app.py
elif [ "$BACKGROUND" = "true" ]; then
    # This shell is PID 1 here, so stop the children on `docker stop`.
    trap 'trap - TERM INT; kill 0; exit 0' TERM INT
    crl_regen_forever &
    wait
else
    echo "PKI ready (no services enabled; nothing will refresh the CRL)"
fi
