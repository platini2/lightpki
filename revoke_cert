#!/bin/sh
set -e
umask 077
if [ $# -ne 1 ] ; then
    echo 'revoke_cert <CN>'
    echo 'revoke_cert ftp.example.com'
    exit 1
fi
case "$1" in
    \*.*)
        WILDCARD_REST=${1#\*.}
        case "$WILDCARD_REST" in
            ''|*[!A-Za-z0-9._-]*)
                echo "Invalid CN '$1': wildcard must be '*.' followed by letters, digits, '.', '_', '-'" >&2
                exit 1
                ;;
        esac
        ;;
    *[!A-Za-z0-9._-]*)
        echo "Invalid CN '$1': only letters, digits, '.', '_', '-', or a single leading '*.' wildcard are allowed" >&2
        exit 1
        ;;
esac
echo "-----------------------------"
echo "Revoking Intermediate CA Certificate for $1"
echo "-----------------------------"
cd $INTERMEDIATECA_DIRECTORY
openssl ca -config ../intermediate-openssl.cnf \
      -passin env:INTERMEDIATECA_PASSPHRASE \
      -revoke "certs/$1.cert.pem"
